# ---------------------------------------------------------------------------
# Seul DISCORD_TOKEN est obligatoire. Tout le reste se règle ensuite DEPUIS
# DISCORD avec /config (clé API, clan, salons…). Les variables ci-dessous ne
# servent que de valeurs initiales : ce qui est enregistré via /config prime.
# ---------------------------------------------------------------------------
DISCORD_TOKEN=

# Facultatif : chemin de la base SQLite
DB_PATH=data/bot.db
# Facultatif : « Server Members Intent » (à activer dans le portail Discord) pour l'accueil
# automatique des nouveaux. Passe à false pour le désactiver (redémarrage nécessaire).
MEMBERS_INTENT=true
# Facultatif : clé de chiffrement de la clé API stockée en base (défaut : dérivée de DISCORD_TOKEN)
# SECRET_KEY=

# --- Valeurs initiales facultatives (équivalents de /config) ---
# CR_API_TOKEN=
# CLAN_TAG=#XXXXXXXX
# CR_API_BASE_URL=https://proxy.royaleapi.dev/v1
# JOIN_CHANNEL_ID=
# LEAVE_CHANNEL_ID=
# LOG_CHANNEL_ID=
# WAR_CHANNEL_ID=
# WELCOME_CHANNEL_ID=
# GUILD_ID=
# STAFF_ROLE_ID=
# POLL_INTERVAL=10
# TIMEZONE=Europe/Paris
# WAR_REMINDER_TIMES=08:00,18:00
# LINK_VERIFICATION=token
